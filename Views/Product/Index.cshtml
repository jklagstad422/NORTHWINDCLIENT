@model IEnumerable<NORTHWINDCLIENT.Models.Product>

<div class="container mt-4">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Category">Categories</a></li>
        <li class="breadcrumb-item active">@ViewBag.CategoryName</li>
      </ol>
    </nav>

    <h3>Products: @ViewBag.CategoryName</h3>

    <table class="table table-striped table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th class="text-end">Price</th>
                <th class="text-end">In Stock</th>
                <th>Package</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.ProductName</td>
                    <td class="text-end">@p.UnitPrice.ToString("C")</td>
                    <td class="text-end">@p.UnitsInStock</td>
                    <td>@p.QuantityPerUnit</td>
                </tr>
            }
        </tbody>
    </table>
</div>