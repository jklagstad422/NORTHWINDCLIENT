@model IEnumerable<NORTHWINDCLIENT.Models.Category>

<div class="container mt-4">
    <h2 class="display-6">Product Categories</h2>
    <hr />
    <ul class="list-group">
        @foreach (var item in Model)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <strong>@item.CategoryName</strong> - @item.Description
                </div>
                <a asp-action="Index" asp-route-id="@item.CategoryId" class="btn btn-sm btn-primary">View Products</a>
            </li>
        }
    </ul>
</div>